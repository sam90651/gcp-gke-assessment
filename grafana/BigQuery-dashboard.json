      "panel-3": {
        "kind": "Panel",
        "spec": {
          "id": 3,
          "title": "Request latency p50 / p95 / p99",
          "description": "",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "query": {
