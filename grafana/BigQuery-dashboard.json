                      "spec": {
                        "editorMode": "code",
                        "format": 1,
                        "location": "us-central1",
                        "project": "project-f0424c60-4a52-470d-b10",
                        "rawQuery": true,
                        "rawSql": "SELECT\n  APPROX_QUANTILES(latency_ms, 100)[OFFSET(50)] AS p50_ms,\n  APPROX_QUANTILES(latency_ms, 100)[OFFSET(95)] AS p95_ms,\n  APPROX_QUANTILES(latency_ms, 100)[OFFSET(99)] AS p99_ms\nFROM (\n  SELECT SAFE_CAST(REGEXP_EXTRACT(\n    COALESCE(textPayload, TO_JSON_STRING(jsonPayload)),\n    r'\"latency_ms\":\\s*(\\d+)'\n  ) AS INT64) AS latency_ms\n  FROM `project-f0424c60-4a52-470d-b10.gke_logs.stdout`\n  WHERE $__timeFilter(timestamp)\n)\nWHERE latency_ms IS NOT NULL",
                        "sql": {
                          "columns": [
                            {
                              "parameters": [],
                              "type": "function"
                            }
