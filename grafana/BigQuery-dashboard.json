                        "project": "project-f0424c60-4a52-470d-b10",
                        "rawQuery": true,
                        "rawSql": "SELECT\n  TIMESTAMP_TRUNC(timestamp, MINUTE) AS time,\n  AVG(SAFE_CAST(REGEXP_EXTRACT(COALESCE(textPayload, TO_JSON_STRING(jsonPayload)), r'\"cpu_pct\":\\s*(\\d+)') AS INT64)) AS cpu_pct,\n  AVG(SAFE_CAST(REGEXP_EXTRACT(COALESCE(textPayload, TO_JSON_STRING(jsonPayload)), r'\"memory_mib\":\\s*(\\d+)') AS INT64)) AS memory_mib\nFROM `project-f0424c60-4a52-470d-b10.gke_logs.stdout`\nWHERE $__timeFilter(timestamp)\nGROUP BY time\nHAVING cpu_pct IS NOT NULL\nORDER BY time",
